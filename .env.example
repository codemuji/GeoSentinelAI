# GeoSentinel AI Configuration

# 1. Google Gemini API Key (Required for GenAI Geological Intelligence)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Microsoft Planetary Computer Subscription Key (Optional)
# Satellite COG streaming and STAC search work anonymously out-of-the-box for free.
# Add a key only if you need higher rate limits: https://planetarycomputer.microsoft.com/
PC_SDK_SUBSCRIPTION_KEY=

# 3. OpenAlex API Key (Optional)
# Regional geological literature search works anonymously out-of-the-box.
# Add your key for faster response times and premium rate limits: https://openalex.org/
OPENALEX_KEY=
